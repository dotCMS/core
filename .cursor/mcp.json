{
  "mcpServers": {
    "nx-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "nx-mcp@0.25.0"
      ]
    },
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@angular/cli@22.2.5",
        "mcp"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@1.12.0"]
    }
  }
}
