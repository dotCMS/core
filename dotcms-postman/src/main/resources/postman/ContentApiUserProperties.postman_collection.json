    {
      "name": "Anonymous - GraphQL content map - no user properties",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Anonymous request: clear any session cookie left by an earlier request of this run.",
              "pm.sendRequest({ url: pm.environment.get('serverURL') + '/api/v1/logout', method: 'GET' }, function () {});",
              "// The GraphQL schema learns the new content type asynchronously",
              "setTimeout(function(){}, 5000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const userKeys = [\"owner\", \"ownerUserName\", \"modUser\", \"modUserName\", \"publishUser\", \"publishUserName\", \"lockedBy\", \"lockedByName\"];",
              "const missing = (object) => userKeys.filter((key) => Object.prototype.hasOwnProperty.call(object, key));",
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().data.search;",
              "pm.test('content returned', () => pm.expect(rows).to.not.be.empty);",
              "pm.test('no user properties', () => rows.forEach((row) => pm.expect(missing(row._map)).to.be.empty));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{serverURL}}/api/v1/graphql?dotcachettl=0",
          "host": [
            "{{serverURL}}"
          ],
          "path": [
            "api",
            "v1",
            "graphql"
          ],
          "query": [
            {
              "key": "dotcachettl",
              "value": "0"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"{ search(query: \\\"+identifier:{{contentId}}\\\") { identifier _map } }\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
