{
	"info": {
		"_postman_id": "7b8ac411-5a81-5339-86e7-c469663d995a",
		"name": "ManagementEndpoints",
		"description": "Checks that /dotmgt/* is served only on the management port.\n\n{{serverURL}} is the main port and {{managementURL}} the management port; the runner passes both (postman.server.url and postman.management.url in dotcms-postman/pom.xml).\n\nmanagementPort and regularPort are the ports inside the container (CMS_MANAGEMENT_PORT and the HTTP connector). The server compares X-Forwarded-Port with these, not with the host ports Docker publishes, so they stay 8090 and 8080 whatever host ports the stack uses.\n\nA refused or unknown management request gets dotCMS's generic not-found page (the filter sends a bare 404), so the tests check for that page rather than a specific message.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Setup",
			"item": [
				{
					"name": "Wait for the management port to report ready",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Same wait as the Karate waitForReady helper: poll readyz every 10 s, up to 30 attempts (5 minutes).",
									"const attempt = Number(pm.collectionVariables.get('readyAttempt') || 0) + 1;",
									"const ready = pm.response.code === 200 && pm.response.text() === 'ready';",
									"if (ready || attempt >= 30) {",
									"    pm.collectionVariables.unset('readyAttempt');",
									"    pm.test('Management port reports ready within 5 minutes', function () {",
									"        pm.expect(pm.response.code).to.eql(200);",
									"        pm.expect(pm.response.text()).to.eql('ready');",
									"    });",
									"} else {",
									"    pm.collectionVariables.set('readyAttempt', attempt);",
									"    console.log('readyz returned ' + pm.response.code + ', attempt ' + attempt + ' of 30');",
									"    setTimeout(function () {}, 10000);",
									"    pm.execution.setNextRequest(pm.info.requestName);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{managementURL}}/dotmgt/readyz",
							"host": [
								"{{managementURL}}"
							],
							"path": [
								"dotmgt",
								"readyz"
							]
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
