{
    "info": {
        "_postman_id": "125b2baf-6ed4-48f2-9200-5832c86a64d6",
        "name": "BulkUploadResource",
        "description": "Postman collection for POST /api/v1/assets/_bulkupload (#37166).\n\nStub created by /speckit-implement T003. Requests are added under T021, which sits behind the US1 TDD gates (T022 approval, T023 Red) \u2014 do not add them ahead of those.\n\nContract: specs/37166-bulk-file-upload/contracts/bulk-upload-api.md",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Accepts a batch and answers 202 with a handle",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('202 Accepted, not 200 \u2014 the work has not happened yet', function () {",
                            "    pm.response.to.have.status(202);",
                            "});",
                            "pm.test('carries both jobId and statusUrl', function () {",
                            "    const e = pm.response.json().entity;",
                            "    pm.expect(e).to.have.property('jobId');",
                            "    pm.expect(e).to.have.property('statusUrl');",
                            "    pm.collectionVariables.set('jobId', e.jobId);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "files",
                            "type": "file",
                            "src": "a.txt"
                        },
                        {
                            "key": "files",
                            "type": "file",
                            "src": "b.txt"
                        },
                        {
                            "key": "form",
                            "value": "{\"baseType\":\"DOTASSET\",\"folderId\":\"{{folderId}}\"}",
                            "type": "text",
                            "contentType": "application/json"
                        }
                    ]
                },
                "url": {
                    "raw": "{{serverURL}}/api/v1/assets/_bulkupload",
                    "host": [
                        "{{serverURL}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "assets",
                        "_bulkupload"
                    ]
                },
                "description": "The happy path (contracts \u00a71, spec FR-002). The response must arrive before the files exist \u2014 202 means queued, not done \u2014 and must carry statusUrl as well as jobId so the client is not left assembling URLs by hand."
            },
            "response": []
        },
        {
            "name": "Refuses a batch with no files",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "form",
                            "value": "{\"baseType\":\"DOTASSET\",\"folderId\":\"{{folderId}}\"}",
                            "type": "text",
                            "contentType": "application/json"
                        }
                    ]
                },
                "url": {
                    "raw": "{{serverURL}}/api/v1/assets/_bulkupload",
                    "host": [
                        "{{serverURL}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "assets",
                        "_bulkupload"
                    ]
                },
                "description": "An empty batch is not an empty success (spec FR-003)."
            },
            "response": []
        },
        {
