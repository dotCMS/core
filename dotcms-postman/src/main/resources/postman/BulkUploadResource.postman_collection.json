            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "files",
                            "type": "file",
                            "src": "a.txt"
                        },
                        {
                            "key": "form",
                            "value": "{\"baseType\":\"HTMLPAGE\",\"folderId\":\"{{folderId}}\"}",
                            "type": "text",
                            "contentType": "application/json"
                        }
                    ]
                },
                "url": {
                    "raw": "{{serverURL}}/api/v1/assets/_bulkupload",
                    "host": [
                        "{{serverURL}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "assets",
                        "_bulkupload"
                    ]
                },
                "description": "Only DOTASSET and FILEASSET carry files; anything else reaches the creation path with no binary to place (spec FR-003)."
            },
            "response": []
