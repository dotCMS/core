		{
			"name": "GetFailedRecords",
			"item": [
				{
					"name": "FailedRecordsAsAdmin",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "65fc199c-4793-423f-acc4-429d41fed8ba",
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"",
									"pm.test(\"Root carries limits, retry policy, count and records\", function () {",
									"    const entity = pm.response.json().entity;",
									"    pm.expect(entity).to.have.all.keys('limits', 'retryPolicy', 'failedRecordCount', 'failedRecords');",
									"    pm.expect(entity.limits.maxStringLength.value).to.be.a('number');",
									"    pm.expect(entity.limits.maxStringLength.unit).to.eql('chars');",
									"    pm.expect(entity.limits.maxNestingDepth.value).to.be.a('number');",
									"    pm.expect(entity.limits.maxNestingDepth.unit).to.eql('levels');",
									"    pm.expect(entity.retryPolicy.maxRetries).to.be.a('number');",
									"    pm.expect(entity.failedRecords).to.be.an('array');",
									"    pm.expect(entity.failedRecordCount).to.eql(entity.failedRecords.length);",
									"});",
									"",
									"pm.test(\"Records identify the content without its values\", function () {",
									"    const keys = ['identifier', 'inode', 'title', 'contentTypeVariable', 'languageId', 'archived', 'operation',",
									"        'failedAttempts', 'priority', 'failureReason', 'violation'];",
									"    pm.response.json().entity.failedRecords.forEach(function (record) {",
									"        pm.expect(Object.keys(record)).to.have.members(keys);",
									"        pm.expect(record).to.not.have.property('contentlet');",
									"    });",
									"});",
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"name": "Content-Type",
								"type": "text",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{serverURL}}/api/v1/index/failed",
							"host": [
								"{{serverURL}}"
							],
							"path": [
								"api",
								"v1",
								"index",
								"failed"
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "admin@dotcms.com",
									"type": "string"
								},
								{
									"key": "password",
									"value": "admin",
									"type": "string"
								}
							]
						}
					},
					"response": []
