{
  "info": {
    "_postman_id": "ad232a1a-2485-4d37-87c4-00620629cf8d",
    "name": "ContentJsonAttributes",
    "description": "Content JSON attributes (audit fields, Story Block body normalization, validation errors, anonymous and wrong-credential writes) and retrieval of newly created content by identifier and inode with DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE on. Moved from the Karate features CheckingJSONAttributes and CreateNewContents.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('jwt')) {",
          "    throw new Error('Set environment jwt to a pre-issued dotCMS API token, or use the Node runner.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Checking JSON Attributes",
      "item": [
        {
          "name": "Checking Content Audit Attributes",
          "item": [
            {
              "name": "Create a content type with a Story Block body",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// This collection owns the type it checks Story Block normalization against, so a collection that redefines",
                      "// webPageContent (ContentTypeResourceTests imports a bundle with a WYSIWYG body) cannot change the result.",
                      "pm.collectionVariables.set('jsonAttrsContentType', 'JsonAttrsStoryBlock' + Date.now());"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Content type is created and its id is captured', function () {",
                      "    const type = pm.response.json().entity[0];",
                      "    pm.expect(type.id, 'id of the created content type').to.be.a('string').and.not.empty;",
                      "    pm.collectionVariables.set('jsonAttrsContentTypeId', type.id);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{serverURL}}/api/v1/contenttype",
                  "host": [
                    "{{serverURL}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "contenttype"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clazz\": \"com.dotcms.contenttype.model.type.ImmutableSimpleContentType\",\n  \"name\": \"{{jsonAttrsContentType}}\",\n  \"variable\": \"{{jsonAttrsContentType}}\",\n  \"host\": \"8a7d5e23-da1e-420a-b4f0-471e7da8ea2d\",\n  \"folder\": \"SYSTEM_FOLDER\",\n  \"workflow\": [\n    \"d61a59e1-a49c-46f2-a929-db2b4bfa88b2\"\n  ],\n  \"fields\": [\n    {\n      \"clazz\": \"com.dotcms.contenttype.model.field.ImmutableHostFolderField\",\n      \"dataType\": \"SYSTEM\",\n      \"name\": \"Site\",\n      \"variable\": \"contentHost\",\n      \"required\": true,\n      \"sortOrder\": 1\n    },\n    {\n      \"clazz\": \"com.dotcms.contenttype.model.field.ImmutableTextField\",\n      \"dataType\": \"TEXT\",\n      \"name\": \"Title\",\n      \"variable\": \"title\",\n      \"required\": true,\n      \"indexed\": true,\n      \"listed\": true,\n      \"sortOrder\": 2\n    },\n    {\n      \"clazz\": \"com.dotcms.contenttype.model.field.ImmutableStoryBlockField\",\n      \"dataType\": \"LONG_TEXT\",\n      \"name\": \"Body\",\n      \"variable\": \"body\",\n      \"sortOrder\": 3\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Creating Test Generic Content",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Content is created and its identifier is captured', function () {",
                      "    const firstResult = pm.response.json().entity.results[0];",
                      "    const key = Object.keys(firstResult)[0];",
                      "    pm.expect(firstResult[key].identifier, 'identifier of the created content').to.be.a('string').and.not.empty;",
                      "    pm.collectionVariables.set('jsonAttrsContentId', firstResult[key].identifier);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{serverURL}}/api/v1/workflow/actions/default/fire/PUBLISH",
                  "host": [
                    "{{serverURL}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "workflow",
                    "actions",
                    "default",
                    "fire",
                    "PUBLISH"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"contentlet\": [\n    {\n      \"contentType\": \"{{jsonAttrsContentType}}\",\n      \"title\": \"Test Generic Content\",\n      \"contentHost\": \"default\",\n      \"body\": \"This is my Test Generic Content\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Retrieving Test Generic Content",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Content type, title and host name are returned', function () {",
                      "    const entity = pm.response.json().entity;",
                      "    pm.expect(entity.contentType).to.eql(pm.collectionVariables.get('jsonAttrsContentType'));",
                      "    pm.expect(entity.title).to.eql('Test Generic Content');",
                      "    pm.expect(entity.hostName).to.eql('default');",
                      "});",
                      "",
                      "pm.test('Audit attributes are present and not null', function () {",
                      "    const entity = pm.response.json().entity;",
                      "    [\"creationDate\", \"owner\", \"ownerUserName\", \"modDate\", \"modUser\", \"modUserName\", \"publishDate\", \"publishUser\", \"publishUserName\"].forEach(function (attribute) {",
                      "        pm.expect(entity[attribute], \"The '\" + attribute + \"' attribute must be present and not null\")",
                      "            .to.exist;",
                      "    });",
                      "});",
                      "",
                      "// Story Block fields are normalized to a Tiptap/ProseMirror doc on save (#36002): a plain",
                      "// string body is stored and read back as structured JSON, not the raw string.",
                      "pm.test('Body is normalized to a Story Block doc', function () {",
                      "    const body = pm.response.json().entity.body;",
                      "    pm.expect(body.type).to.eql('doc');",
                      "    pm.expect(body.content[0].content[0].text).to.eql('This is my Test Generic Content');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{serverURL}}/api/v1/content/{{jsonAttrsContentId}}",
                  "host": [
                    "{{serverURL}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "content",
                    "{{jsonAttrsContentId}}"
                  ]
                }
              },
              "response": []
            },
