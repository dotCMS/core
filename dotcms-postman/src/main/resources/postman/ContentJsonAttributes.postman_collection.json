        {
          "name": "Cleanup - Destroy created content",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The assertions of every request that ran while DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE was changed. They run",
                  "// here, after the property is restored, because a failed assertion earlier would have skipped the restore.",
                  "const unstash = function (name) {",
                  "    const raw = pm.collectionVariables.get('stash_' + name);",
                  "    pm.collectionVariables.unset('stash_' + name);",
                  "    const stashed = raw ? JSON.parse(raw) : { status: null, text: '' };",
                  "    let json = {};",
                  "    try { json = JSON.parse(stashed.text); } catch (e) { /* not JSON: the status assertion reports it */ }",
                  "    return { status: stashed.status, text: stashed.text, entity: json.entity || {} };",
                  "};",
                  "const turnOn = unstash('turnOn');",
                  "const byIdentifier = unstash('byIdentifier');",
                  "const byInode = unstash('byInode');",
                  "const turnOff = unstash('turnOff');",
                  "const noCredentials = unstash('noCredentials');",
                  "const wrongCredentials = unstash('wrongCredentials');",
                  "const restore = unstash('restore');",
                  "",
                  "pm.test('Restore: status code is 200', function () {",
                  "    pm.expect(restore.status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Turn on: status code is 200', function () {",
                  "    pm.expect(turnOn.status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Turn on: property is saved', function () {",
                  "    pm.expect(turnOn.entity).to.include('DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE saved/updated');",
                  "});",
                  "",
                  "pm.test('By identifier: status code is 200', function () {",
                  "    pm.expect(byIdentifier.status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('The identifier matches the created content', function () {",
                  "    pm.expect(byIdentifier.entity.identifier).to.eql(pm.collectionVariables.get('newContentId'));",
                  "});",
                  "",
                  "pm.test('By inode: status code is 200', function () {",
                  "    pm.expect(byInode.status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('The inode matches the created content', function () {",
                  "    pm.expect(byInode.entity.inode).to.eql(pm.collectionVariables.get('newContentInode'));",
                  "});",
                  "",
                  "pm.test('Turn off: status code is 200', function () {",
                  "    pm.expect(turnOff.status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Turn off: property is saved', function () {",
                  "    pm.expect(turnOff.entity).to.include('DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE saved/updated');",
                  "});",
                  "",
                  "pm.test('No credentials: status code is 401', function () {",
                  "    pm.expect(noCredentials.status).to.eql(401);",
                  "});",
                  "",
                  "pm.test('Anonymous write is rejected', function () {",
                  "    pm.expect(noCredentials.text).to.include('CONTENT_APIS_ALLOW_ANONYMOUS permission denied');",
                  "});",
                  "",
                  "pm.test('Wrong credentials: status code is 401', function () {",
                  "    pm.expect(wrongCredentials.status).to.eql(401);",
                  "});",
                  "",
                  "pm.test('Wrong credentials are rejected', function () {",
                  "    pm.expect(wrongCredentials.text).to.include('CONTENT_APIS_ALLOW_ANONYMOUS permission denied');",
                  "});",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset('newContentId');",
                  "pm.collectionVariables.unset('newContentInode');"
                ]
              }
            }
          ],
