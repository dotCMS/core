    {
      "name": "Create New Contents",
      "item": [
        {
          "name": "Create content to read back (newContent.feature)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content is created with no errors', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.errors).to.eql([]);",
                  "    pm.expect(json.entity.title).to.include(pm.collectionVariables.get('newContentKey'));",
                  "    pm.collectionVariables.set('newContentId', json.entity.identifier);",
                  "    pm.collectionVariables.set('newContentInode', json.entity.inode);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newContentKey', 'SucessRequest' + new Date().toISOString().slice(0, 19));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{serverURL}}/api/v1/workflow/actions/default/fire/PUBLISH",
              "host": [
                "{{serverURL}}"
              ],
              "path": [
                "api",
                "v1",
                "workflow",
                "actions",
                "default",
                "fire",
                "PUBLISH"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentlet\": {\n    \"stInode\": \"f4d7c1b8-2c88-4071-abf1-a5328977b07d\",\n    \"languageId\": 1,\n    \"key\": \"{{newContentKey}}\",\n    \"value\": \"{{newContentKey}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Remember the current DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The property may not exist yet (404): remember that separately from its value, so the cleanup deletes",
                  "// a property that did not exist but restores one that existed with an empty value.",
                  "pm.test('Status code is 200 or 404', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "pm.collectionVariables.set('originalDefaultContentToDefaultLanguageMissing', String(pm.response.code === 404));",
                  "pm.collectionVariables.set('originalDefaultContentToDefaultLanguage', pm.response.code === 200 ? String(pm.response.json().entity) : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serverURL}}/api/v1/system-table/DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE",
              "host": [
                "{{serverURL}}"
              ],
              "path": [
                "api",
                "v1",
                "system-table",
                "DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Turn on DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Newman runs with bail: true, so a failed assertion would skip the cleanup that restores",
                  "// DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE. Keep this request assertion-free: stash what it returned and",
                  "// check it in the last cleanup request, after the property is restored.",
                  "pm.collectionVariables.set('stash_turnOn', JSON.stringify({ status: pm.response.code, text: pm.response.text() }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
