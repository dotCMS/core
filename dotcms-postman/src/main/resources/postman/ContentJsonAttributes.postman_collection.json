              "host": [
                "{{serverURL}}"
              ],
              "path": [
                "api",
                "v1",
                "system-table"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"DEFAULT_CONTENT_TO_DEFAULT_LANGUAGE\",\n  \"value\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
