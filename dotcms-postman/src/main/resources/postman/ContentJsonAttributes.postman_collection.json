              "name": "Creating Test Generic Content without parameters",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "// Every result is keyed by the contentlet's identifier (or '{}' when there is none), so",
                      "// collect the error message of whatever key each result carries.",
                      "pm.test('Errors contain: Content Type does not exist', function () {",
                      "    const errors = [];",
                      "    pm.response.json().entity.results.forEach(function (result) {",
                      "        Object.keys(result).forEach(function (key) {",
                      "            if (result[key] && result[key].errorMessage) { errors.push(result[key].errorMessage); }",
                      "        });",
                      "    });",
                      "    pm.expect(errors).to.include(\"Content Type does not exist\");",
                      "});"
                    ]
                  }
                }
              ],
