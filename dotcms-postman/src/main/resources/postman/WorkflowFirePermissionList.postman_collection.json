						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Site is created\", function () {",
									"    pm.expect(pm.response.json().entity.identifier).to.be.a(\"string\").and.not.empty;",
									"});",
									"pm.collectionVariables.set(\"siteId\", pm.response.json().entity.identifier);"
								]
