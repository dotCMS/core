				{
					"name": "Read the contentlet permission rows before the editor acts",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const asRows = (rows) => rows",
									"    .map(r => ({ roleId: r.roleId, permission: r.permission, type: r.type }))",
									"    .sort((a, b) => (a.roleId + ':' + a.permission + ':' + a.type).localeCompare(b.roleId + ':' + b.permission + ':' + b.type));",
									"const rows = asRows(pm.response.json().entity);",
									"pm.test(\"The editor is on the contentlet\", function () {",
									"    pm.expect(rows.map(r => r.roleId)).to.include(pm.collectionVariables.get(\"editorRoleId\"));",
									"});",
									"pm.collectionVariables.set(\"rowsBefore\", JSON.stringify(rows));"
								]
