       ],
       "path": [
        "api",
        "v1",
        "roles"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n    \"roleName\": \"layouts-pm-tools-role-{{runId}}\",\n    \"roleKey\": \"layouts-pm-tools-role-{{runId}}\",\n    \"canEditUsers\": true,\n    \"canEditPermissions\": false,\n    \"canEditLayouts\": false,\n    \"description\": \"Postman: non-admin role for /v1/layouts gate tests (canEditUsers so users can be added)\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('role created', () => pm.response.to.have.status(200));",
         "pm.collectionVariables.set('toolsRoleId', pm.response.json().entity.id);"
        ]
       }
      }
     ]
    },
