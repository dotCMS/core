  {
   "name": "Layouts",
   "item": [
    {
     "name": "US1 - list sections as admin - 200",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{serverURL}}/api/v1/layouts",
       "host": [
        "{{serverURL}}"
       ],
       "path": [
        "api",
        "v1",
        "layouts"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const entity = pm.response.json().entity;",
         "pm.test('entity is a non-empty array', () => { pm.expect(entity).to.be.an('array'); pm.expect(entity.length).to.be.above(0); });",
         "pm.test('section shape', () => { const s = entity[0]; pm.expect(s).to.have.all.keys('id','name','icon','tabOrder','portletIds','portletTitles'); pm.expect(s.portletIds.length).to.eql(s.portletTitles.length); });",
         "pm.test('no raw title keys', () => { entity.forEach(s => s.portletTitles.forEach(t => pm.expect(t).to.not.match(/^com\\.dotcms\\.repackage/))); });",
         "pm.collectionVariables.set('originalOrder', JSON.stringify(entity.map(s => s.id)));",
         "pm.collectionVariables.set('maxTabOrder', String(Math.max(...entity.map(s => s.tabOrder))));"
        ]
       }
      }
     ],
     "response": []
    },
