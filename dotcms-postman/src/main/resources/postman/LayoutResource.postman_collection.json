        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const s = pm.response.json().entity;",
         "pm.test('saved section returned', () => { pm.expect(s.name).to.eql('PM Section ' + pm.collectionVariables.get('runId')); pm.expect(s.icon).to.eql('bolt'); pm.expect(s.portletIds).to.eql([]); });",
         "pm.test('appended after the last section', () => pm.expect(s.tabOrder).to.be.above(Number(pm.collectionVariables.get('maxTabOrder'))));",
         "pm.collectionVariables.set('sectionId', s.id);"
        ]
       }
      }
     ]
