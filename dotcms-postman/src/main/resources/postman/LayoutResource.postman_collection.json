        "api",
        "v1",
        "layouts"
       ]
      },
      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// Runs before any authenticated request: the runner keeps one cookie jar per collection run,",
         "// and a session cookie from an earlier admin request would authenticate this call (200).",
         "pm.test('401', () => pm.response.to.have.status(401));"
