{
	"info": {
		"_postman_id": "27cc1482-4973-4b4d-865a-3a43f55967dc",
		"name": "ClusterNodesResource",
		"description": "Checks GET /api/v1/cluster/nodes, the typed cluster status endpoint behind the Network (Beta) portlet (#37875): an admin gets every alive server with a computed status, serialized with the documented field names, and an anonymous caller gets 401.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Admin lists the cluster nodes",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Every node has an id, a status and a responded flag\", function () {",
							"    const entity = pm.response.json().entity;",
							"    pm.expect(entity.currentServerId).to.be.a('string');",
							"    pm.expect(entity.nodes).to.be.an('array').that.is.not.empty;",
							"    entity.nodes.forEach(function (node) {",
							"        pm.expect(node.serverId).to.be.a('string');",
							"        pm.expect(['UP', 'LAGGING', 'DOWN']).to.include(node.status);",
							"        pm.expect(node.responded).to.be.a('boolean');",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{serverURL}}/api/v1/cluster/nodes",
					"host": [
						"{{serverURL}}"
					],
					"path": [
						"api",
						"v1",
						"cluster",
						"nodes"
					]
				},
				"description": "An admin lists the alive servers with their status."
			},
			"response": []
		},
		{
			"name": "Anonymous caller is rejected",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"exec": [
							"pm.test(\"Status code is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{serverURL}}/api/v1/cluster/nodes",
					"host": [
						"{{serverURL}}"
					],
					"path": [
						"api",
						"v1",
						"cluster",
						"nodes"
					]
				},
				"description": "A request with no credentials is rejected with 401."
			},
			"response": []
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"if (!pm.environment.get('jwt')) {",
					"    throw new Error('Set environment jwt to a pre-issued dotCMS API token, or use the Node runner.');",
					"}",
					""
				]
			}
		}
	]
}
