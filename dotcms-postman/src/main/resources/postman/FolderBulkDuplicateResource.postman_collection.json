    {
      "name": "Accepts a selection and answers 202 with a handle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });\n\npm.test('Response carries jobId, statusUrl, submitted', function () {\n    const entity = pm.response.json().entity;\n    pm.expect(entity.jobId).to.be.a('string').and.not.empty;\n    pm.expect(entity.statusUrl).to.eql('/api/v1/jobs/' + entity.jobId + '/status');\n    pm.expect(entity.submitted).to.eql(1);\n    pm.collectionVariables.set('jobId', entity.jobId);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{serverURL}}/api/v1/assets/folders/_bulkduplicate",
          "host": [
            "{{serverURL}}"
          ],
          "path": [
            "api",
            "v1",
            "assets",
            "folders",
            "_bulkduplicate"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"assetPaths\": [\"{{folderPath}}\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Answers immediately with a handle, before any folder is duplicated."
      },
      "response": []
    },
    {
      "name": "Waiting for the duplication to finish",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const elapsed = Date.now() - parseInt(pm.collectionVariables.get('pollStart'));\nconst state = pm.response.json().entity.state;\nconst terminal = ['SUCCESS', 'FAILED', 'FAILED_PERMANENTLY', 'CANCELED', 'ABANDONED_PERMANENTLY'].includes(state);\n\nif (!terminal && elapsed < 60000) {\n    setTimeout(function () {}, 2000);\n    pm.execution.setNextRequest('Waiting for the duplication to finish');\n} else {\n    pm.collectionVariables.unset('pollStart');\n    pm.test('The run finished successfully', function () {\n        pm.expect(state).to.eql('SUCCESS');\n    });\n}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('pollStart')) {\n    pm.collectionVariables.set('pollStart', Date.now());\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{serverURL}}/api/v1/jobs/{{jobId}}/status",
          "host": [
            "{{serverURL}}"
          ],
          "path": [
            "api",
            "v1",
            "jobs",
            "{{jobId}}",
            "status"
          ]
        },
        "description": "Polls the job the submission returned until it reaches a terminal state, for at most a minute."
      },
      "response": []
    },
