{
  "info": {
    "_postman_id": "1185452b-d5a5-4164-8767-49adaa80c55a",
    "name": "FolderBulkDuplicateResource",
    "description": "Postman collection for POST /api/v1/assets/folders/_bulkduplicate (#37062).\n\nCovers the happy path end to end (submit, follow the job to a terminal state, find the duplicate beside its source), the advertised ceiling, and the two 400 refusals. This is what verifies the exception mapper over the wire, which the helper-level integration tests cannot see. It creates its own folder and deletes it, and its duplicate, in the final request.\n\nContract: specs/37062-folder-copy-backend/contracts/folder-bulk-duplicate-api.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
