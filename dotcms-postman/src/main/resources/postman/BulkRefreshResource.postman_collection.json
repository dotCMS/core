    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "jobIdNoResults",
      "value": ""
    },
    {
      "key": "pollCount",
      "value": "0"
    },
    {
      "key": "oversizedSelection",
      "value": ""
    }
  ]
}
