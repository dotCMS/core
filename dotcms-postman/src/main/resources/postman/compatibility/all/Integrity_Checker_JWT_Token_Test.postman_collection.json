{
	"info": {
		"name": "Integrity Checker JWT Token Test - ALL compatibility only",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "generate",
			"item": [
				{
					"name": "using_basic_authentication_instead_JWT_token",
					"item": [
						{
							"name": "request_pp",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"type": "text/javascript",
										"exec": [
											"pm.cookies.jar().clear(pm.environment.get('serverURL'), function (err) {",
											"    if (err) throw new Error('Could not isolate authentication test cookies');",
											"});"
										]
									}
								},
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 200\", function () {",
											"    pm.response.to.have.status(401);",
											"});"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "basic",
									"basic": [
										{
											"key": "password",
											"value": "admin",
											"type": "string"
										},
										{
											"key": "username",
											"value": "admin@dotcms.com",
											"type": "string"
										}
									]
								},
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/octet-stream",
										"type": "text"
									},
									{
										"key": "Content-Disposition",
										"value": "attachment",
										"type": "text"
									}
								],
								"body": {
									"mode": "file",
									"file": {
										"src": "../../resources/Push_publish/bundle_test-01EAJHA26FZGPAEZBSGJGNG82A.tar.gz"
									}
								},
								"url": {
									"raw": "{{serverURL}}/api/bundlePublisher/publish",
									"host": [
										"{{serverURL}}"
									],
									"path": [
										"api",
										"bundlePublisher",
										"publish"
									]
								}
							},
							"response": []
						}
					]
				}
			]
		}
	]
}
