    {
      "name": "Anonymous back-end paths are refused",
      "item": [
        {
          "name": "Open an anonymous session that holds a site",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin entry point answers', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
