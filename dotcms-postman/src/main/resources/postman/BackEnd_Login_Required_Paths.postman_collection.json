    {
      "name": "Logged-in users keep access",
      "item": [
        {
          "name": "Get an admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.collectionVariables.set('backendLoginToken', pm.response.json().entity.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user\": \"{{user}}\", \"password\": \"{{password}}\", \"expirationDays\": 1}"
            },
            "url": "{{serverURL}}/api/v1/authentication/api-token"
          }
        },
        {
          "name": "Back-end JSP for a logged-in admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged-in admin gets the page', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{backendLoginToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Referer",
                "value": "{{serverURL}}/dotAdmin/"
              }
            ],
            "url": "{{serverURL}}/html/portlet/ext/contentlet/image_tools/index.jsp"
          },
          "protocolProfileBehavior": {
            "followRedirects": false,
            "disableUrlEncoding": true
          }
        }
      ]
    }
