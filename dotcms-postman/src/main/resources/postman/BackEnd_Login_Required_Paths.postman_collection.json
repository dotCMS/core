{
  "info": {
    "_postman_id": "ad31eb71-5c1c-5452-afff-6856533cacdc",
    "name": "BackEnd_Login_Required_Paths",
    "description": "Anonymous requests for back-end paths are refused however the path is spelled (percent-encoded dot segments in either case, path parameters, repeated slashes, servlet paths without a trailing slash), while public paths and logged-in users keep working.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
