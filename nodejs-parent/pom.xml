<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dotcms</groupId>
        <artifactId>dotcms-parent</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../parent/pom.xml</relativePath>
    </parent>
    <artifactId>dotcms-nodejs-parent</artifactId>
    <packaging>pom</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <node.js.version>v22.22.3</node.js.version>
        <pnpm.version>12.4.2</pnpm.version>
        <node.install.dir>${maven.multiModuleProjectDirectory}/installs/node</node.install.dir>
        <!-- npm exposes the pnpm binary under <prefix>/bin, not directly in the prefix
             the way corepack's shim used to sit at ${node.install.dir}/pnpm. Consuming
             modules must invoke these properties rather than hardcoding a path, and must
             keep ${pnpm.bin.dir} on PATH: nested `pnpm exec` calls resolve pnpm from PATH
             (dotcms-webcomponents' build target, libs/sdk/create-app/scripts/verify-package.sh),
             and pnpm prepends only node_modules/.bin to a child's environment — never the
             directory holding its own executable. Without it the build silently falls back
             to whatever pnpm the machine happens to have. -->
        <pnpm.bin.dir>${node.install.dir}/bin</pnpm.bin.dir>
        <pnpm.executable>${pnpm.bin.dir}/pnpm</pnpm.executable>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${maven.multiModuleProjectDirectory}/installs</installDirectory>
                    <nodeVersion>${node.js.version}</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!--
              Install pnpm with the npm that frontend-maven-plugin just installed,
              into the same prefix as Node.
              pnpm 12 ships as a native binary through @pnpm/exe.* optional
              dependencies. Installing it with npm runs the wrapper's install.js,
              which links the platform binary in place, so everything lands inside
              installs/ where CI's node-binary cache already picks it up.
              Corepack, by contrast, runs no lifecycle scripts: its shim would
              download the native binary on first use into ~/.cache/node/corepack,
              outside that cache, on every job.
              We invoke npm-cli.js directly with the installed node binary to use
              the bundled copy rather than whatever npm happens to be on PATH.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <!--
                      Prepend installs/node to PATH so the `#!/usr/bin/env node`
                      shebang of npm and of anything it runs picks up our
                      installed Node 22, not whatever the runner happens to have
                      in its default PATH (GitHub Actions ships Node 20).
                    -->
                    <environmentVariables>
                        <PATH>${pnpm.bin.dir}:${node.install.dir}:${env.PATH}</PATH>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>install-pnpm</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${node.install.dir}/node</executable>
                            <arguments>
                                <argument>${node.install.dir}/node_modules/npm/bin/npm-cli.js</argument>
                                <argument>install</argument>
                                <argument>-g</argument>
                                <argument>--prefix</argument>
                                <argument>${node.install.dir}</argument>
                                <argument>pnpm@${pnpm.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-root-npmrc</id>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                echo "Using node.js ${node.js.version}" for project default
                                <echo append="false" file="${maven.multiModuleProjectDirectory}/.nvmrc">${node.js.version}</echo>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
