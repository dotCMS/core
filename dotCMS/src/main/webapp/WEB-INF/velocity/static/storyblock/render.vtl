##
## Renders a list of inline/block nodes. $inLink is true when the caller has already opened an
## <a> for the whole run, so text nodes skip their own anchor (#37340).
#macro(renderStoryBlockNodes $data $inLink)#*
    *##foreach($element in $data)#*
        *##if( $element.type == "paragraph" )
#*          *#<p#if(${element.attrs.textAlign}) style="text-align: $element.attrs.textAlign;"#end>#*
                *##renderContentBlock($element.content)#*
            *#</p>#*
        *##elseif( $element.type == "heading" )#*
            *##if($element.attrs.level == "1")
#*              *#<h1#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h1>
#*          *##elseif($element.attrs.level == "2")
#*              *#<h2#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h2>
#*          *##elseif($element.attrs.level == "3")
#*              *#<h3#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h3>
#*          *##elseif($element.attrs.level == "4")
#*              *#<h4#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h4>
#*          *##elseif($element.attrs.level == "5")
#*              *#<h5#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h5>
#*          *##elseif($element.attrs.level == "6")
#*              *#<h6#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                    *##renderContentBlock($element.content)#*
                *#</h6>
#*          *##end#*
        *##elseif( $element.type == "listItem" )
#*        *#  <li#{if}(${element.attrs.textAlign}) style="text-align: ${element.attrs.textAlign};"#{end}>#*
                *##renderContentBlock($element.content)#*
          *#  </li>
#*      *##elseif( $element.type == "bulletList" )
#*        *#  <ul#{if}(${element.attrs.textAlign}) style="text-align: ${element.attrs.textAlign};"#{end}>#*
                *##renderContentBlock($element.content)#*
          *#  </ul>
#*      *##elseif( $element.type == "orderedList" )
#*        *#  <ol#{if}(${element.attrs.textAlign}) style="text-align: ${element.attrs.textAlign};"#{end}>#*
                *##renderContentBlock($element.content)#*
          *#  </ol>
#*      *##elseif( $element.type == "codeBlock" )
#*          *#<pre><code>#renderContentBlock($element.content)</code></pre>
#*      *##elseif( $element.type == "blockquote" )
#*          *#<blockquote#if($element.attrs.textAlign) style="text-align: $element.attrs.textAlign;"#end>#*
                *##renderContentBlock($element.content)#*
            *#</blockquote>#*
        *##elseif( $element.type == "table" )
#*          *#<table#if($!element.attrs.ariaLabel) aria-label="$esc.html($!element.attrs.ariaLabel)"#end#if($!element.attrs.ariaLabelledby) aria-labelledby="$esc.html($!element.attrs.ariaLabelledby)"#end>#if($!element.attrs.caption)<caption>$esc.html($!element.attrs.caption)</caption>#end#renderContentBlock($element.content)</table>
#*      *##elseif( $element.type == "tableRow" )
#*        *#  <tr>
#*        *##renderContentBlock($element.content)
#*        *#  </tr>
#*      *##elseif( $element.type == "tableHeader" )
#*      *#    <th colspan="$!element.attrs.colspan" rowspan="$!element.attrs.rowspan" colwidth="$!element.attrs.colwidth"#if($!element.attrs.scope) scope="$!element.attrs.scope"#end>#renderContentBlock($element.content)</th>
#*      *##elseif( $element.type == "tableCell" )
#*      *#    <td colspan="$!element.attrs.colspan" rowspan="$!element.attrs.rowspan" colwidth="$!element.attrs.colwidth" >#renderContentBlock($element.content)</td>
#*      *##elseif( $element.type == "hardBreak" )#*
            *#<br />
#*      *##elseif( $element.type == "horizontalRule" )
#*          *#<hr />
#*      *##elseif( $element.type == "dotImage" )#*
            *##if($dotStoryBlockRenderHelper)#*
                *#$dotStoryBlockRenderHelper.render($element)#*
            *##else#*
                *##set($item = $element)#*
                *##parse("static/storyblock/dotImage.vtl")#*
            *##end#*
        *##elseif( $element.type == "dotContent" )#*
            *##if($dotStoryBlockRenderHelper)#*
                *#$dotStoryBlockRenderHelper.render($element)#*
            *##else#*
                *##set($item = $element)#*
                *##parse("static/storyblock/dotContent.vtl")#*
            *##end#*
        *##elseif( $element.type == "dotVideo" )#*
            *##if($dotStoryBlockRenderHelper)#*
                *#$dotStoryBlockRenderHelper.render($element)#*
            *##else#*
                *##set($item = $element)#*
                *##parse("static/storyblock/dotVideo.vtl")#*
            *##end#*
        *##elseif( $element.type == "dotAudio" )#*
            *##if($dotStoryBlockRenderHelper)#*
                *#$dotStoryBlockRenderHelper.render($element)#*
            *##else#*
                *##set($item = $element)#*
                *##parse("static/storyblock/dotAudio.vtl")#*
            *##end#*
        *##elseif( $element.type == "gridBlock" )#*
            *##set($item = $element)#*
            *##parse("static/storyblock/gridBlock.vtl")#*
        *##elseif( $element.type == "text" )#*
            *##renderMarks($element, $inLink)#*
        *##elseif( $element.type == "emoji" )#*
            *###
            ## Legacy content only - the editor no longer creates emoji nodes (#37340). The node
            ## stores a shortcode, never the character, so before this branch existed the macro
            ## had no case for it and silently dropped the character from the published page.
            ## The name is user-controlled (no Story Block schema validation on the REST API),
            ## so the resolved fallback is escaped.
            *##if($dotStoryBlockRenderHelper)#*
                *#${esc.html($dotStoryBlockRenderHelper.emoji($element))}#*
            *##else#*
                *#:${esc.html($!{element.attrs.name})}:#*
            *##end#*
        *##end#*
    *##end#*
*##end

##
## Entry point. Groups siblings into link runs so one logical link renders as ONE <a> (#37340).
##
## Rendering node by node opened and closed an anchor per text node, so stored JSON with several
## text nodes sharing a link produced several anchors: duplicate tab stops, duplicate
## screen-reader entries and a fragmented announcement (WCAG 2.2 A - 1.3.1, 2.4.4, 4.1.2). In the
## reported payload the two linked text nodes are not even adjacent, because the mark-less emoji
## node sits between them, so the run has to absorb it.
##
## The grouping lives in StoryBlockRenderHelper (Java) rather than here: it is unit-testable
## there, and this macro renders every Story Block field on every VTL page. When the helper is
## absent from the context the macro falls back to the original flat behaviour.
#macro(renderContentBlock $data)#*
    *##if($dotStoryBlockRenderHelper)#*
        *##foreach($run in $dotStoryBlockRenderHelper.linkRuns($data))#*
            *##if($run.linked)#*
                *#<a href="${esc.html($!{run.link.attrs.href})}"#*
                *##if($!{run.link.attrs.target}) target="${esc.html($!{run.link.attrs.target})}"#end#*
                *##if($!{run.link.attrs.title}) title="${esc.html($!{run.link.attrs.title})}"#end#*
                *##if($run.link.attrs.get("aria-label")) aria-label="${esc.html($run.link.attrs.get('aria-label'))}"#end#*
                *##if($!{run.link.attrs.rel}) rel="${esc.html($!{run.link.attrs.rel})}"#end#*
                *#>#*
                *##renderStoryBlockNodes($run.nodes, true)#*
                *#</a>#*
            *##else#*
                *##renderStoryBlockNodes($run.nodes, false)#*
            *##end#*
        *##end#*
    *##else#*
        *##renderStoryBlockNodes($data, false)#*
    *##end#*
*##end
