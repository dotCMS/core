<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">


    <Properties>
        <Property name="DOTCMS_LOG_FILE">${sys:catalina.home}/logs/dotcms.log</Property>
        <Property name="DOTCMS_FILENAME_PATTERN">${sys:catalina.home}/logs/archive/dotcms-%i.log.gz</Property>
        <!-- Control characters other than tab and line ends (a carriage return counts as a line
             end only before a line feed), written as "?" in messages and exception text.
             %ex{none} keeps log4j from appending a second, unfiltered trace. -->
        <Property name="CONTROL_CHARS">[\x00-\x08\x0B\x0C\x0E-\x1F\x7F-\x9F\u2028\u2029]|\r(?!\n)</Property>
        <Property name="MESSAGE_PATTERN">[%d{dd/MM/yy HH:mm:ss:SSS z}] %5p %c{2}: %replace{%enc{%m}{CRLF}}{${CONTROL_CHARS}}{?}%n%replace{%ex}{${CONTROL_CHARS}}{?}%ex{none}</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS}  %-5level %logger{2} - %replace{%enc{%msg}{CRLF}}{${CONTROL_CHARS}}{?}%n%replace{%ex}{${CONTROL_CHARS}}{?}%ex{none}" />
        </Console>

        <!--  Generic Logging File -->
        <RollingFile name="Generic-File"
                     fileName="${DOTCMS_LOG_FILE}"
                     filePattern="${DOTCMS_FILENAME_PATTERN}"
                     immediateFlush="false">
            <PatternLayout pattern="${MESSAGE_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="20MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console" />
            <AppenderRef ref="Generic-File"/>
        </Root>
    </Loggers>
</Configuration> 
