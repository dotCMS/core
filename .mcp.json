{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@1.12.0"],
      "env": {}
    },
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": ["@angular/cli@22.2.5", "mcp"],
      "env": {}
    },
    "nx-mcp": {
      "command": "npx",
      "args": ["-y", "nx-mcp@0.25.0"]
    }
  }
}
