{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@0.18.1"],
      "env": {}
    },
    "primeng": {
      "command": "npx",
      "args": ["-y", "@primeng/mcp@21.1.1"]
    },
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": ["@angular/cli@21.1.2", "mcp"],
      "env": {}
    }
  }
}
