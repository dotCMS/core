{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@1.12.0"],
      "env": {}
    },
    "primeng": {
      "command": "npx",
      "args": ["-y", "@primeng/mcp@22.1.4"]
    },
    "angular-cli": {
      "type": "stdio",
      "command": "npx",
      "args": ["@angular/cli@22.2.5", "mcp"],
      "env": {}
    }
  }
}