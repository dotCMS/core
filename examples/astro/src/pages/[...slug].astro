---
import "@/styles/global.css";
import Layout from "@/components/common/Layout.astro";
import Error from "@/components/common/Error.astro";
import { getDotCMSPage } from "@/dotcms-integration";
import { DotCMSPage } from "@/views/DotCMSPage";

const params = Astro.params;

const pageResponse = await getDotCMSPage(params?.slug ?? "");

if (!pageResponse.ok && pageResponse.error.httpError?.status === 404) {
  return Astro.redirect("/404");
}

// Set on a failed fetch, and also on a page that loaded but whose content query
// came back with GraphQL errors. Matches the blog pages.
const error = pageResponse.error;
const pageAsset = pageResponse.ok ? pageResponse.pageAsset : undefined;
const { vanityUrl } = pageAsset ?? {};

if (vanityUrl && (vanityUrl.temporaryRedirect || vanityUrl.permanentRedirect)) {
  return Astro.redirect(
    vanityUrl.forwardTo,
    vanityUrl.permanentRedirect ? 301 : 302,
  );
}

const title = pageAsset ? pageAsset.page.title : "Error";
---

{
  (
    <Layout title={title}>
      {error ? (
        <Error error={error} />
      ) : pageResponse.ok ? (
        <DotCMSPage client:only="react" pageResponse={pageResponse} />
      ) : null}
    </Layout>
  )
}
