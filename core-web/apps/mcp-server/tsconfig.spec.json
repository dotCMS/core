{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // TODO(#35932): base enables these two workspace-wide. These specs still trip
        // TS4111 (index-signature access) and TS4114 (missing `override`) — `strict`
        // itself already passes. Drop these two lines once those are cleaned up.
        "outDir": "../../dist/out-tsc",
        "module": "esnext",
        "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
        "moduleResolution": "bundler",
        "noPropertyAccessFromIndexSignature": false,
        "noImplicitOverride": false
    },
    "include": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.d.ts"
    ],
    "files": ["src/test-setup.ts"]
}
