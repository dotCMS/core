{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "preserve",
        "outDir": "../out-tsc/spec",
        "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
        "target": "ES2022",
        "useDefineForClassFields": false,
        "isolatedModules": true,
        "moduleResolution": "bundler"
    },
    "files": ["src/test-setup.ts"],
    "include": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.d.ts"
    ]
}
