{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "preserve",
        "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
        "target": "ES2022",
        "useDefineForClassFields": false,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "isolatedModules": true
    },
    "include": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.d.ts"
    ],
    "files": ["src/test-setup.ts"]
}
