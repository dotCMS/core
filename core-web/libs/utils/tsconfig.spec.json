{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "preserve",
        "types": ["vitest/globals", "node"],
        "target": "ES2022",
        "useDefineForClassFields": false,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite.config.mts"]
}
