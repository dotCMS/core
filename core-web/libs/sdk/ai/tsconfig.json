{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        // TODO(#35932): base enables these two workspace-wide. This project still trips
        // TS4111 (index-signature access) and TS4114 (missing `override`) — `strict`
        // itself already passes. Drop these two lines once those are cleaned up.
        "noPropertyAccessFromIndexSignature": false,
        "noImplicitOverride": false,
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": ["node"]
    },
    "files": [],
    "include": [],
    "references": [
        {
            "path": "./tsconfig.lib.json"
        },
        {
            "path": "./tsconfig.spec.json"
        }
    ]
}
