{
    "name": "sdk-ai",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/sdk/ai/src",
    "projectType": "library",
    "tags": ["scope:ai"],
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals",
            {
                "runtime": "node -e \"console.log(require('node:crypto').createHash('sha256').update(require('node:fs').readFileSync('../dotCMS/src/main/webapp/WEB-INF/openapi/openapi.yaml')).digest('hex'))\""
            }
        ]
    },
    "targets": {
        "generate-spec": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsx scripts/generate-spec.ts",
                "cwd": "libs/sdk/ai"
            }
        },
        "build": {
            "dependsOn": ["^build", "generate-spec"],
            "cache": true,
            "inputs": [
                "production",
                "^production",
                {
                    "externalDependencies": ["rollup"]
                }
            ]
        },
        "publish": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node tools/scripts/publish.mjs sdk-ai {args.ver} {args.tag}"
            }
        },
        "nx-release-publish": {
            "options": {
                "packageRoot": "dist/libs/sdk/ai"
            }
        },
        "lint": {
            "options": {
                "args": ["src/**/*.ts", "scripts/**/*.ts"]
            }
        },
        "test": {
            "dependsOn": ["generate-spec"]
        }
    }
}
