{
    "name": "sdk-angular",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/sdk/angular/src",
    "prefix": "lib",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "metadata": {
                "description": "Builds the published package with the Angular pinned in toolchain/ (the SDK's supported floor), not core-web's. Do not switch back to @nx/angular:package: it compiles with core-web's Angular, which makes the package unusable on older Angular versions. See toolchain/README.md."
            },
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "defaultConfiguration": "production",
            "options": {
                "command": "node libs/sdk/angular/toolchain/build.mjs",
                "cwd": "{workspaceRoot}"
            },
            "configurations": {
                "production": {},
                "development": {}
            }
        }
    }
}
