{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../dist/out-tsc",
        "declaration": true,
        "types": [""],
        "target": "es2020",
        "module": "es2020",
        "moduleResolution": "bundler"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx",
        "src/standalone.ts",
        "src/lib/standalone/**"
    ]
}
