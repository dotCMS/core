{
    "name": "sdk-analytics",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/sdk/analytics/src",
    "projectType": "library",
    "tags": ["type:lib", "scope:sdk", "feature:analytics", "skip:build"],
    "targets": {
        "build:standalone": {
            "inputs": [
                "production",
                "^production",
                "warBuild",
                { "externalDependencies": ["vite"] }
            ],
            "dependsOn": ["^build"],
            "outputs": ["{workspaceRoot}/dist/libs/sdk/analytics-standalone"],
            "options": {
                "config": "./vite.standalone.config.mts",
                "outDir": "../../../dist/libs/sdk/analytics-standalone"
            }
        }
    }
}
