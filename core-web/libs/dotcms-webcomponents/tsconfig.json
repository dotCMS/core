{
    "compilerOptions": {
        "baseUrl": "../..",
        "paths": {
            "@dotcms/dotcms-models": ["libs/dotcms-models/src/index.ts"],
            "@dotcms/dotcms-models/*": ["libs/dotcms-models/src/*"]
        },
        "allowSyntheticDefaultImports": true,
        "allowUnreachableCode": false,
        "declaration": false,
        // Strict mode (#35943). Stencil type-checks during `build`, so these are load-bearing:
        // breaking them breaks CI, and `dotcms-webcomponents:test` cannot run at all (Stencil
        // supports Jest 27, the workspace is on 29) so the build is the only gate. Verify it by
        // EXIT STATUS — its output prints "build finished" on the transpile step even when the
        // type check then fails.
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        //
        // Do NOT add `"ignoreDeprecations": "6.0"` here: Stencil bundles TypeScript 5.8.3, which
        // only accepts "5.0" and fails the build with `Invalid value for '--ignoreDeprecations'`.
        // No single value satisfies both compilers, so this stays on the CLI.
        //
        // ⚠️ Measuring this project WITHOUT that flag silently reports nothing. The repo's tsc
        // is 6.0.3 and raises TS5101 (`baseUrl`) and TS5107 (`moduleResolution=node10`) for the
        // deprecated options below — and, like TS2688 and TS6053, a config-level error aborts
        // the compiler before semantic checking. You get 2 errors and zero type checking. Always
        // type-check this project with:
        //   pnpm exec tsc -p libs/dotcms-webcomponents/tsconfig.json --noEmit --ignoreDeprecations 6.0
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "lib": ["dom", "es2015"],
        "moduleResolution": "node",
        "module": "esnext",
        "target": "es2017",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "react",
        "jsxFactory": "h",
        "types": ["node"],
        "skipLibCheck": true
    },
    "exclude": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.e2e.ts", "**/*.e2e.tsx"],
    "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "stencil-types.d.ts"]
}
